---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../islands/CookieConsent';
import { u, pic } from '../lib/url';
import { orgLd } from '../lib/schema';
import { IMAGES } from '../lib/catalog';

interface Props { title: string; description: string; image?: string; noindex?: boolean }
const { title, description, image, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Показ на GitHub Pages закрыт от поиска (PUBLIC_NOINDEX=1), чтобы не дублировать живой rozalii.ru.
const closed = noindex || import.meta.env.PUBLIC_NOINDEX === '1';
const og = new URL(image || pic(IMAGES.hero.src, 1600), Astro.site);
const isStand = !import.meta.env.PUBLIC_LEAD_URL;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {closed && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Розалия" />
    <meta name="theme-color" content="#12452a" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="sr-only" href="#main">К содержимому</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <CookieConsent client:idle />
    {isStand && <div style="position:fixed;left:12px;bottom:12px;z-index:20;background:#fff6e6;border:1px solid #ecd3a4;color:#6a4a12;font-size:12px;border-radius:8px;padding:4px 8px">Тестовый стенд</div>}
    <script type="application/ld+json" set:html={JSON.stringify(orgLd(new URL(u('/'), Astro.site).href))} />
    <script>
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-cookie-settings]')) window.dispatchEvent(new Event('rz-consent-open'));
      });
    </script>
  </body>
</html>
