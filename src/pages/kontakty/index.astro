---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Img from '../../components/Img.astro';
import LeadSection from '../../components/LeadSection.astro';
import { R, SITE } from '../../lib/site';
import { u } from '../../lib/url';
---
<Base title="Контакты – Розалия, ритуальные венки в Сергиевом Посаде"
  description={`Телефон ${SITE.phones[0].text}, почта ${SITE.email}. Производство и самовывоз: ${SITE.addressShort}. ${SITE.hours}.`}>
  <Crumbs items={[{ name: 'Контакты' }]} />
  <section class="sec--tight"><div class="wrap">
    <h1>Контакты</h1>
    <p class="lead">Оформить заказ, уточнить наличие, рассчитать доставку или получить условия для оптовых поставок.</p>
  </div></section>
  <section class="sec--tight"><div class="wrap grid g3">
    <div class="card"><h3>Телефон</h3>{SITE.phones.map((p) => <p style="margin:0 0 6px"><a href={p.href} style="font-size:20px;font-weight:700">{p.text}</a></p>)}<p class="mut">{SITE.hours}</p></div>
    <div class="card"><h3>Почта</h3><p><a href={`mailto:${SITE.email}`} style="font-size:18px;font-weight:700">{SITE.email}</a></p><p class="mut">Для заявок, прайса и документов.</p></div>
    <div class="card"><h3>Производство и самовывоз</h3><p>{SITE.address}</p><p class="mut">Перед приездом позвоните – подтвердим готовность и время.</p></div>
  </div></section>
  <section class="sec"><div class="wrap split">
    <div>
      <h2>Доставка</h2>
      <p>По Сергиеву Посаду и ближайшим городам:</p>
      <ul class="chips-list">{SITE.geo.map((g) => <li>{g}</li>)}</ul>
      <p class="mut" style="margin-top:16px">Возложение к памятной дате – и по Москве. Опт в другие регионы – транспортными компаниями.</p>
      <a href={u(R.dostavka)}>Подробнее о доставке →</a>
    </div>
    <Img name="kontakty" alt="Ритуальные композиции Розалия" />
  </div></section>
  <section class="sec--tight"><div class="wrap">
    <h2>Реквизиты</h2>
    <p class="stand">Реквизиты (ИП/организация, ИНН, ОГРН) на сайте-источнике не заполнены – ждём от владельца.</p>
  </div></section>
  <LeadSection />
</Base>
