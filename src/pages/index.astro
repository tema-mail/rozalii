---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import ProductCard from '../components/ProductCard.astro';
import Faq from '../components/Faq.astro';
import LeadSection from '../components/LeadSection.astro';
import { PRODUCTS, IMAGES, inSection } from '../lib/catalog';
import { R, SECTIONS, SERVICES, SITE } from '../lib/site';
import { u, pic } from '../lib/url';

// Хиты на главную: у кого есть имя и цвета – их ищут и выбирают чаще; остальные – в каталоге.
const hits = PRODUCTS.filter((p) => !p.placeholder).slice(0, 8);
const reviews = [
  ['Маргарита', 'Заказывали венок для отца через сайт. Заказ выполнили за два дня, изделие получилось аккуратным, достойным и очень близким к варианту в каталоге.'],
  ['Сергей', 'Заказывали три траурных венка с лентами. Быстро связались, заказ подготовили раньше обещанного срока. Отдельно отметили качество сборки и реалистичный вид цветов.'],
  ['Владимир', 'Венок понадобился срочно. Заказ соответствовал фотографии и описанию на сайте, надпись на ленте сделали без ошибок, доставили вовремя.'],
  ['Ульяна', 'Обращалась за венками уже дважды. Оба заказа понравились, композиции доставили вовремя. Чёткая работа и профессиональное отношение в непростой ситуации.'],
];
const faq: [string, string][] = [
  ['Работаете только оптом?', 'Нет. Основное направление – оптовые поставки, но в Сергиевом Посаде и ближайших городах принимаем и розничные заказы.'],
  ['Можно заказать венок срочно?', 'Да. Принимаем срочные заказы и при возможности производства изготовим изделие в день обращения.'],
  ['Можно изготовить венок по фотографии или эскизу?', 'Да. Изготавливаем ритуальные венки по индивидуальным эскизам, фотографиям и пожеланиям заказчика.'],
  ['Можно заказать траурную ленту вместе с венком?', 'Да. Подготовим ленту выбранного цвета с вашим текстом и добавим её к венку, корзине или композиции.'],
  ['Можете доставить заказ прямо к месту прощания?', 'Да. Доставляем венки и композиции в морг, крематорий, храм и к месту церемонии к согласованному времени.'],
  ['Можно заказать доставку, если я не могу присутствовать лично?', 'Да. Доставим и возложим венок или корзину, после выполнения отправим фотоотчёт – в том числе к памятным датам.'],
];
---
<Base title="Производство ритуальных венков в Сергиевом Посаде"
  description="Производство ритуальных венков, корзин и композиций в Сергиевом Посаде. Опт и розница, срочное изготовление, лента с надписью, доставка к месту прощания.">
  <section class="hero"><div class="wrap hero__in">
    <div>
      <h1>Ритуальные венки и композиции от производителя в Сергиевом Посаде</h1>
      <p class="lead">Производим венки, корзины и композиции сами. Опт и розница, стандарт и на заказ. Доставка по Подмосковью, отправка оптовых заказов по России.</p>
      <div class="btns"><a class="btn" href={u(R.katalog)}>Смотреть каталог</a><a class="btn btn--line" href={u(R.optom)}>Оптовый прайс</a></div>
      <div class="grid g3" style="margin-top:28px">
        {SECTIONS.map((s) => (
          <a class="cattile" href={u(`/katalog/${s.slug}/`)}>
            <img src={pic(IMAGES[s.img].src, 800)} alt="" width="72" height="72" loading="eager" />
            <div>{s.short}<span>{inSection(s.slug).length} моделей</span></div>
          </a>
        ))}
      </div>
    </div>
    <div class="hero__img"><Img name="hero" alt="Ритуальные венки и корзина производства Розалия" eager /></div>
  </div></section>

  <section class="sec--tight"><div class="wrap grid g4">
    <div class="feat"><span class="ic">1</span><div><b>Собственное производство</b><span class="mut">Каркасы, сборка и контроль – у себя, без посредников.</span></div></div>
    <div class="feat"><span class="ic">2</span><div><b>Опт любого объёма</b><span class="mut">До 2 000 изделий в месяц, поставка под реализацию.</span></div></div>
    <div class="feat"><span class="ic">3</span><div><b>Срочное изготовление</b><span class="mut">При возможности производства – в день обращения.</span></div></div>
    <div class="feat"><span class="ic">4</span><div><b>Доставка и отправка</b><span class="mut">Свой транспорт по Подмосковью, опт по России – ТК.</span></div></div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="head"><h2>Популярные модели</h2><p>Венки 90–140 см, корзины и композиции. У многих моделей несколько цветовых исполнений.</p></div>
    <div class="prods prods--4">{hits.map((p) => <ProductCard p={p} />)}</div>
    <div class="btns" style="margin-top:24px"><a class="btn" href={u(R.katalog)}>Весь каталог – {PRODUCTS.length} моделей</a></div>
  </div></section>

  <section class="sec sec--soft"><div class="wrap split">
    <div>
      <h2>Ритуальная продукция оптом</h2>
      <p>Работаем с ритуальными магазинами, агентствами, точками при кладбищах. Можно начать с небольшой партии или договориться о регулярных поставках под ваш ассортимент.</p>
      <ul class="chips-list" style="margin:16px 0 24px"><li>Мелкий, средний и крупный опт</li><li>Цена от производителя</li><li>Поставка под реализацию</li><li>Своя доставка</li></ul>
      <div class="btns"><a class="btn" href={u(R.optom)}>Условия для оптовиков</a><a class="btn btn--line" href={u(R.cabinet)}>Кабинет оптовика – демо</a></div>
    </div>
    <Img name="optom" alt="Обсуждение оптовой поставки ритуальных венков" />
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="head"><h2>Дополнительные услуги</h2><p>Кроме изготовления помогаем с доставкой, возложением и оформлением к церемонии или памятной дате.</p></div>
    <div class="grid g4">
      <a class="tile" href={u('/katalog/')}><Img name="lenty" alt="Траурные ленты с надписью" sizes="(max-width: 640px) 50vw, 25vw" />
        <div class="tile__b"><h3>Траурные ленты</h3><p>Белая, чёрная, красная или бордовая лента с вашим текстом – выбирается в карточке товара.</p></div></a>
      {SERVICES.map((s) => (
        <a class="tile" href={u(`/uslugi/${s.slug}/`)}><Img name={s.img} alt={s.name} sizes="(max-width: 640px) 50vw, 25vw" />
          <div class="tile__b"><h3>{s.name}</h3><p>{s.text}</p><div class="tile__more">Подробнее →</div></div></a>
      ))}
    </div>
  </div></section>

  <section class="sec sec--soft"><div class="wrap">
    <h2>Как получить заказ</h2>
    <div class="grid g3" style="margin-top:20px">
      <div class="card"><h3>Самовывоз</h3><p>Заберите заказ с производства после того, как менеджер подтвердит готовность. {SITE.addressShort}.</p></div>
      <div class="card"><h3>Доставка своим транспортом</h3><p>По Сергиеву Посаду и ближайшим городам, в том числе к указанному времени в морг, крематорий, храм или к месту церемонии.</p></div>
      <div class="card"><h3>Отправка по России</h3><p>Оптовые заказы отправляем транспортными компаниями. Стоимость зависит от объёма и направления.</p></div>
    </div>
    <p style="margin-top:20px"><a href={u(R.dostavka)}>Доставка и оплата подробно →</a></p>
  </div></section>

  <section class="sec" id="otzyvy"><div class="wrap">
    <h2>Отзывы клиентов</h2>
    <div class="grid g4" style="margin-top:20px">
      {reviews.map(([n, t]) => <div class="rev"><div class="rev__h"><span class="rev__a">{n[0]}</span><div><b>{n}</b><div class="rev__s">★★★★★</div></div></div><p>{t}</p></div>)}
    </div>
  </div></section>

  <Faq items={faq} />
  <LeadSection />
</Base>
