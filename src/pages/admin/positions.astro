---
/** Админка → «Позиции» – экран кабинета gaz-mag (← TEYES Sibir, вид EV SIBIR) без вкладки «Нейросети» (владелец 27.10.2026:
    «полная, без срезов по ИИ»). С 02.11.2026 – реальный срез: scripts/real-analytics.py → src/data/live/positions.json
    (снимок выдачи XMLRiver, Москва и область, топ-20; спрос – Вордстат 27.10.2026). */
import Admin from '../../layouts/Admin.astro';
import Positions from '../../islands/admin/Positions';
import { allProducts } from '../../lib/catalog';
import live from '../../data/live/positions.json';
import '../../styles/positions.css';
---
<Admin title="Позиции" active="positions" count={allProducts.filter((p) => !p.archived).length}>
  <p class="demo-note" style="max-width:1160px;margin:0 auto 14px">Реальные данные. Места в выдаче – снимок XMLRiver {String((live as any).nsk?.measured_to ?? '').slice(0, 10).split('-').reverse().join('.')} для человека в Москве и области, первые 20 результатов. Показов и кликов из Вебмастера пока нет: сайт в Вебмастере подтверждён, но Яндекс ещё не загрузил по нему данные (02.11.2026). Search Console к rozalii.ru не подключена.</p>
  <Positions client:load data={live as any} />
</Admin>
