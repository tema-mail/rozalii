---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { TREE, type Node } from '../../lib/pages';
import { u } from '../../lib/url';
const list = (ns: Node[]): string => `<ul>${ns.map((n) => `<li><a href="${u(n.href)}">${n.name}</a>${n.children ? list(n.children) : ''}</li>`).join('')}</ul>`;
---
<Base title="Карта сайта – Розалия" description="Все разделы, товары и страницы сайта Розалия: каталог ритуальных венков, услуги, опт, доставка, контакты.">
  <Crumbs items={[{ name: 'Карта сайта' }]} />
  <section class="sec--tight"><div class="wrap legal"><h1>Карта сайта</h1><Fragment set:html={list(TREE)} /></div></section>
</Base>
