---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Img from '../../components/Img.astro';
import Steps from '../../components/Steps.astro';
import LeadSection from '../../components/LeadSection.astro';
import { R, SERVICES } from '../../lib/site';
import { u } from '../../lib/url';
---
<Base title="Ритуальные услуги в Сергиевом Посаде: доставка и возложение"
  description="Траурные ленты с надписью, доставка венков к месту прощания, возложение к памятной дате и оформление зала – от производителя в Сергиевом Посаде.">
  <Crumbs items={[{ name: 'Услуги' }]} />
  <section class="hero"><div class="wrap hero__in">
    <div>
      <h1>Ритуальные услуги: доставка, возложение, оформление зала</h1>
      <p class="lead">Кроме изготовления венков, корзин и композиций делаем траурные ленты, доставляем заказы к месту прощания, выполняем возложение к памятным датам и оформляем залы для церемонии.</p>
      <div class="btns"><a class="btn" href="#zayavka">Оставить заявку</a><a class="btn btn--line" href={u(R.katalog)}>Смотреть каталог</a></div>
    </div>
    <div class="hero__img"><Img name="uslugi" alt="Ритуальные услуги Розалия" eager /></div>
  </div></section>
  <section class="sec--tight"><div class="wrap grid g4">
    {SERVICES.map((s) => <a class="tile" href={u(`/uslugi/${s.slug}/`)}><Img name={s.img} alt={s.name} sizes="(max-width: 640px) 50vw, 25vw" /><div class="tile__b"><h3>{s.name}</h3><p>{s.text}</p><div class="tile__more">Подробнее →</div></div></a>)}
    <a class="tile" href={u(R.katalog)}><Img name="lenty" alt="Траурные ленты" sizes="(max-width: 640px) 50vw, 25vw" /><div class="tile__b"><h3>Траурные ленты с надписью</h3><p>Белая, чёрная, красная или бордовая лента с вашим текстом – выбирается в карточке любого товара.</p><div class="tile__more">В каталог →</div></div></a>
  </div></section>
  <section class="sec sec--soft"><div class="wrap">
    <h2>Можно объединить в одном заказе</h2>
    <p class="lead">Венок или корзина → траурная лента → доставка → размещение или возложение → фотоотчёт.</p>
  </div></section>
  <Steps title="Как заказать услугу" items={[['Выберите услугу', 'Лента, доставка, возложение или оформление зала.'], ['Передайте данные', 'Дата, время, адрес и детали заказа.'], ['Согласуем', 'Уточним состав заказа и условия.'], ['Выполним', 'Изготовим, доставим или возложим, пришлём фотоотчёт.']]} />
  <LeadSection kind="service" />
</Base>
