---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Img from '../../components/Img.astro';
import Steps from '../../components/Steps.astro';
import Faq from '../../components/Faq.astro';
import LeadSection from '../../components/LeadSection.astro';
import { R, SECTIONS } from '../../lib/site';
import { IMAGES, inSection } from '../../lib/catalog';
import { u, pic } from '../../lib/url';
const adv: [string, string, string][] = [
  ['Собственное производство', 'Сами делаем каркасы, закупаем материалы и собираем изделия – контроль качества, цены и сроков, без посредников.', 'opt-1'],
  ['Цена от производителя', 'Своё производство и прямой закуп сырья. Нашли аналог дешевле – сообщите, постараемся предложить лучшие условия.', 'opt-2'],
  ['Быстрое производство', 'Срок зависит от объёма и состава: крупные партии – до недели, из наличия – быстрее.', 'opt-3'],
  ['Поставка под реализацию', 'Можно сначала оценить спрос, затем оплатить по договорённости. Количество и условия – индивидуально.', 'opt-4'],
  ['Доставка оптовых заказов', 'Своим транспортом – по Сергиеву Посаду и рядом; по России – транспортными компаниями.', 'opt-5'],
  ['Под ваш ассортимент', 'Нет нужного варианта – изготовим по фото, эскизу или параметрам, всё согласуем до запуска.', 'opt-6'],
];
---
<Base title="Ритуальные венки оптом от производителя – Сергиев Посад"
  description="Венки, корзины и композиции оптом от производителя: до 2 000 изделий в месяц, цена без посредников, поставка под реализацию, отправка ТК по России.">
  <Crumbs items={[{ name: 'Оптом' }]} />
  <section class="hero"><div class="wrap hero__in">
    <div>
      <h1>Ритуальные венки и композиции оптом от производителя</h1>
      <p class="lead">Работаем с ритуальными магазинами, агентствами и точками при кладбищах. Небольшие партии, регулярные поставки и крупные заказы – до 1 500–2 000 изделий в месяц.</p>
      <div class="btns"><a class="btn" href="#zayavka">Получить оптовый прайс</a><a class="btn btn--line" href={u(R.cabinet)}>Кабинет оптовика – демо</a></div>
    </div>
    <div class="hero__img"><Img name="optom" alt="Оптовые поставки ритуальных венков" eager /></div>
  </div></section>
  <section class="sec--tight"><div class="wrap">
    <h2>Поставки под задачи вашего бизнеса</h2>
    <div class="grid g3" style="margin-top:16px">
      <div class="card"><h3>Небольшие партии</h3><p class="mut">Подберём ассортимент для магазина или точки без закупки большого объёма одной позиции.</p></div>
      <div class="card"><h3>Регулярные поставки</h3><p class="mut">Постоянный ассортимент из венков, корзин и композиций с пополнением по мере продаж.</p></div>
      <div class="card"><h3>Крупные заказы</h3><p class="mut">Собственное производство позволяет брать большие партии – в среднем до 1 500–2 000 изделий в месяц.</p></div>
    </div>
  </div></section>
  <section class="sec"><div class="wrap">
    <h2>Ассортимент для опта</h2>
    <div class="grid g3" style="margin-top:16px">{SECTIONS.map((s) => <a class="cattile" href={u(`/katalog/${s.slug}/`)}><img src={pic(IMAGES[s.img].src, 800)} alt="" width="72" height="72" loading="lazy" /><div>{s.name}<span>{inSection(s.slug).length} моделей</span></div></a>)}</div>
  </div></section>
  <section class="sec sec--soft"><div class="wrap">
    <h2>Почему с нами работают</h2>
    <div class="grid g3" style="margin-top:16px">{adv.map(([h, t, im]) => <div class="tile"><Img name={im} alt={h} sizes="(max-width: 640px) 100vw, 33vw" /><div class="tile__b"><h3>{h}</h3><p>{t}</p></div></div>)}</div>
  </div></section>
  <section class="sec"><div class="wrap split">
    <div>
      <h2>Личный кабинет оптовика</h2>
      <p>Готовим для партнёров кабинет: оптовые цены на весь каталог, скидка от объёма заказа, заявки на товар под реализацию в пределах лимита, статусы и баллы, документы и акт сверки.</p>
      <a class="btn" href={u(R.cabinet)}>Посмотреть демо кабинета</a>
    </div>
    <Img name="opt-6" alt="Кабинет оптовика" />
  </div></section>
  <Steps title="Как начать сотрудничество" items={[['Оставьте заявку', 'Какая продукция и примерный объём интересуют.'], ['Получите каталог и цены', 'Подберём позиции и дадим актуальные условия поставки.'], ['Согласуем заказ', 'Ассортимент, количество, сроки, оплата и доставка.'], ['Изготовим и доставим', 'Своим транспортом или через транспортную компанию.']]} />
  <Faq items={[['Можно заказать небольшую партию?', 'Да. Работаем с заказами разного объёма – от небольших партий для отдельных точек до регулярных крупных поставок.'],
    ['Сколько занимает производство?', 'Срок зависит от объёма и ассортимента. Крупные заказы стараемся выполнить примерно за неделю, продукцию из наличия передаём быстрее.'],
    ['Можно получить продукцию под реализацию?', 'Да, такой вариант возможен. Объём партии и условия согласуем индивидуально.'],
    ['Отправляете заказы в другие регионы?', 'Да, по России отправляем транспортными компаниями.'],
    ['Можно заказать изделия по своему образцу?', 'Да, изготовим по фотографии, эскизу или индивидуальным параметрам.']]} />
  <LeadSection kind="opt" title="Получите оптовый прайс" button="Получить прайс" text="Расскажите, какая продукция и какой объём нужны – подберём ассортимент, рассчитаем стоимость и предложим доставку." />
</Base>
