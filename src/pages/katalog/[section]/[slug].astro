---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import LeadSection from '../../../components/LeadSection.astro';
import Buy from '../../../islands/Buy';
import { PRODUCTS, productUrl, productSeoTitle, productSeoDescr, productText, related, sectionOf, type Product } from '../../../lib/catalog';
import { R, SERVICES } from '../../../lib/site';
import { u, pic } from '../../../lib/url';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { section: p.section, slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const s = sectionOf(p.section);
const url = new URL(u(productUrl(p)), Astro.site).href;
const props: [string, string][] = [
  ['Раздел', p.sectionName], ...(p.subName ? [['Размер', p.subName] as [string, string]] : []),
  ...(p.variants.length ? [['Исполнения', p.variants.map((v) => v.color).join(', ')] as [string, string]] : []),
  ['Траурная лента', 'по желанию: белая, чёрная, красная, бордовая, с вашим текстом'],
  ['Изготовление', p.madeToOrder ? 'под заказ, срок согласуем' : 'из наличия или срочно – при возможности в день обращения'],
  ['Артикул', p.sku], ['Производитель', 'Розалия, Сергиев Посад'],
];
// Цены нет – Product без offers (Яндекс и Google покажут карточку без цены; offers добавим, когда будет прайс).
const ld = {
  '@context': 'https://schema.org', '@type': 'Product', name: p.title, sku: p.sku, url,
  image: p.photos.map((ph) => new URL(pic(ph, 1000), Astro.site).href),
  description: productText(p).join(' '), brand: { '@type': 'Brand', name: 'Розалия' }, category: p.sectionName,
};
---
<Base title={productSeoTitle(p)} description={productSeoDescr(p)} image={pic(p.photos[0], 1000)}>
  <Crumbs items={[{ name: 'Каталог', href: '/katalog/' }, { name: s.name, href: `/katalog/${s.slug}/` }, { name: p.title }]} />
  <div class="wrap">
    <h1 style="font-size:clamp(26px,3.4vw,40px);margin-top:16px">{p.title}</h1>
    <Buy client:load uid={p.uid} title={p.title} url={productUrl(p)} photos={p.photos} variants={p.variants} sku={p.sku} madeToOrder={p.madeToOrder} />
  </div>

  <section class="sec--tight"><div class="wrap grid g2" style="gap:40px">
    <div>
      <h2 style="font-size:26px">Описание</h2>
      {productText(p).map((t) => <p>{t}</p>)}
      <h2 style="font-size:26px;margin-top:24px">Доставка и получение</h2>
      <p>Самовывоз с производства после подтверждения готовности, доставка своим транспортом по Сергиеву Посаду и ближайшим городам – в том числе к месту прощания к согласованному времени. Оптовые заказы отправляем транспортными компаниями по России. <a href={u(R.dostavka)}>Подробнее</a></p>
      <p>Нужно в другом цвете или по вашему эскизу – изготовим, параметры согласуем до начала работы.</p>
    </div>
    <div>
      <h2 style="font-size:26px">Характеристики</h2>
      <table class="props"><tbody>{props.map(([k, v]) => <tr><td>{k}</td><td>{v}</td></tr>)}</tbody></table>
      <div class="grid" style="margin-top:20px;gap:10px">
        {SERVICES.slice(0, 2).map((x) => <a class="cattile" href={u(`/uslugi/${x.slug}/`)}><div>{x.name}<span>{x.text}</span></div></a>)}
      </div>
    </div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="head"><h2>Похожие модели</h2><a href={u(`/katalog/${s.slug}/`)}>Все: {s.name.toLowerCase()} →</a></div>
    <div class="prods prods--4">{related(p).map((x) => <ProductCard p={x} />)}</div>
  </div></section>
  <LeadSection kind="order" title="Нужна помощь с выбором?" text="Расскажите, к какому дню и куда нужен венок, – подберём модель, ленту и доставку." />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>
