---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Catalog from '../../../components/Catalog.astro';
import Faq from '../../../components/Faq.astro';
import LeadSection from '../../../components/LeadSection.astro';
import { inSection, SIZE_CHIPS } from '../../../lib/catalog';
import { SECTIONS } from '../../../lib/site';

export function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { section: s.slug } }));
}
// SEO разделов: город производства, интент «купить / от производителя / оптом».
const SEO: Record<string, { title: string; descr: string; h1: string; lead: string; faq: [string, string][] }> = {
  'ritualnye-venki': {
    title: 'Ритуальные венки купить в Сергиевом Посаде от производителя – Розалия',
    descr: 'Ритуальные венки 90, 110, 125 и 140 см от производителя в Сергиевом Посаде. Элитные и под заказ, лента с надписью, доставка к месту прощания. Опт и розница.',
    h1: 'Ритуальные венки', lead: 'Венки размером 90, 110, 125 и 140 см – стандартные, элитные и под заказ. У многих моделей несколько цветовых исполнений, к любому венку можно добавить траурную ленту с надписью.',
    faq: [['Какой размер венка выбрать?', 'Размер указан в названии модели – от 90 до 140 см; элитные 140 см – с более плотной композицией. Не уверены – позвоните, менеджер подскажет под место прощания.'],
      ['Можно ли изменить цвет или состав венка?', 'Да. Изготовим по выбранной модели в другом цвете или по вашей фотографии и эскизу – параметры согласуем до начала работы.'],
      ['Сколько изготавливается венок?', 'Модели из наличия передаём быстро, срочный заказ при возможности производства – в день обращения. Венки 140 см «под заказ» – срок назовём при подтверждении.']],
  },
  'ritualnye-korziny': {
    title: 'Ритуальные корзины с цветами купить в Сергиевом Посаде – Розалия',
    descr: 'Плетёные ритуальные корзины с цветочной композицией от производителя в Сергиевом Посаде. Лента с надписью, доставка к месту прощания и возложение. Опт и розница.',
    h1: 'Ритуальные корзины', lead: 'Плетёные корзины с цветочной композицией – для прощания, возложения на кладбище и памятных дат. Добавим траурную ленту с вашей надписью.',
    faq: [['Чем корзина отличается от венка?', 'Корзина ставится на землю или постамент и подходит для возложения к памятнику, венок – на подставке или у гроба.'],
      ['Можно привезти корзину на кладбище без меня?', 'Да, доставим и возложим к памятной дате, пришлём фотоотчёт.']],
  },
  'kompozitsii-v-gorshkakh': {
    title: 'Ритуальные композиции в горшках купить в Сергиевом Посаде – Розалия',
    descr: 'Цветочные ритуальные композиции в декоративных горшках от производителя в Сергиевом Посаде – для памятных дат и возложения. Доставка, опт и розница.',
    h1: 'Композиции в горшках', lead: 'Цветочные композиции в декоративных горшках – для памятной даты, возложения и оформления места прощания.',
    faq: [['Для чего подходят композиции в горшках?', 'Их ставят на могилу к памятным датам, используют для оформления зала прощания и как дополнение к венку.']],
  },
};
const { section } = Astro.params;
const s = SECTIONS.find((x) => x.slug === section)!;
const seo = SEO[section!];
const products = inSection(section!);
---
<Base title={seo.title} description={seo.descr}>
  <Crumbs items={[{ name: 'Каталог', href: '/katalog/' }, { name: s.name }]} />
  <section class="sec--tight"><div class="wrap">
    <h1>{seo.h1}</h1>
    <p class="lead">{seo.lead}</p>
  </div></section>
  <section class="sec--tight"><div class="wrap">
    <Catalog products={products} chips={section === 'ritualnye-venki' ? SIZE_CHIPS : []} />
  </div></section>
  <Faq items={seo.faq} />
  <LeadSection />
</Base>
