---
import { faqLd } from '../lib/schema';
interface Props { items: [string, string][]; title?: string }
const { items, title = 'Частые вопросы' } = Astro.props;
---
<section class="sec faq"><div class="wrap" style="max-width:900px">
  <h2>{title}</h2>
  {items.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
</div></section>
<script type="application/ld+json" set:html={JSON.stringify(faqLd(items))} />
