---
import { u } from '../lib/url';
import { crumbsLd } from '../lib/schema';
interface Props { items: { name: string; href?: string }[] }
const all = [{ name: 'Главная', href: '/' }, ...Astro.props.items];
const ld = crumbsLd(all.map((c) => ({ name: c.name, url: new URL(u(c.href || Astro.url.pathname), Astro.site).href })));
---
<nav class="crumbs wrap" aria-label="Хлебные крошки">
  {all.map((c, i) => <>{i > 0 && <span>/</span>}{c.href && i < all.length - 1 ? <a href={u(c.href)}>{c.name}</a> : <b>{c.name}</b>}</>)}
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
