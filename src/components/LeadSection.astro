---
import LeadForm from '../islands/LeadForm';
import { SITE } from '../lib/site';
import type { Lead } from '../lib/forms';
interface Props { title?: string; text?: string; kind?: Lead['kind']; button?: string }
const { title = 'Оставьте заявку', kind = 'question', button = 'Отправить заявку',
  text = 'Подберём венок, корзину или композицию, назовём стоимость и срок, организуем доставку. Перезвоним и всё уточним.' } = Astro.props;
---
<section class="sec" id="zayavka"><div class="wrap">
  <div class="leadbox">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
      <p>Или позвоните: {SITE.phones.map((p, i) => <>{i > 0 && ', '}<a href={p.href} style="color:#fff">{p.text}</a></>)}<br />{SITE.hours}</p>
    </div>
    <LeadForm client:visible kind={kind} button={button} />
  </div>
</div></section>
