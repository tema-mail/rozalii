---
// Картинка страницы из public/img/s: 800 и 1600 по ширине экрана.
import { IMAGES } from '../lib/catalog';
import { pic } from '../lib/url';
interface Props { name: string; alt: string; eager?: boolean; class?: string; sizes?: string }
const { name, alt, eager = false, class: cls, sizes = '(max-width: 860px) 100vw, 50vw' } = Astro.props;
const im = IMAGES[name];
---
<img class={cls} src={pic(im.src, 800)} srcset={`${pic(im.src, 800)} 800w, ${pic(im.src, 1600)} 1600w`} sizes={sizes}
  width={im.w} height={im.h} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
