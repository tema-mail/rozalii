---
// Юридический документ из src/data/legal/*.txt: «N. Заголовок» → h2, «•» → список, «[НУЖНО …]» и пометки черновика →
// жёлтая плашка (пробел виден, а не спрятан; заполнить до боя – docs/yur-dolgi.md).
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
interface Props { text: string; title: string; description: string }
const { text, title, description } = Astro.props;
const lines = text.split('\n').map((l) => l.trim()).filter(Boolean);
const [h1, ...rest] = lines;
type B = { t: 'h' | 'p' | 'note'; s: string } | { t: 'ul'; s: string[] };
const blocks: B[] = [];
for (const l of rest) {
  if (/^(\[НУЖНО|ПЕРЕД ПУБЛИКАЦИЕЙ|Примечание:|Важно:)/.test(l)) blocks.push({ t: 'note', s: l.replace(/^\[|\]$/g, '') });
  else if (/^\d+\.\s+\S/.test(l) && !/^\d+\.\d/.test(l) && l.length < 90) blocks.push({ t: 'h', s: l });
  else if (l.startsWith('•')) {
    const last = blocks[blocks.length - 1];
    if (last && last.t === 'ul') last.s.push(l.slice(1).trim()); else blocks.push({ t: 'ul', s: [l.slice(1).trim()] });
  } else blocks.push({ t: 'p', s: l });
}
---
<Base title={title} description={description}>
  <Crumbs items={[{ name: h1 }]} />
  <section class="sec--tight"><div class="wrap legal">
    <h1 style="font-size:clamp(26px,3.4vw,38px)">{h1}</h1>
    {blocks.map((b) => b.t === 'h' ? <h2>{b.s}</h2> : b.t === 'ul' ? <ul>{b.s.map((x) => <li>{x}</li>)}</ul>
      : b.t === 'note' ? <p class="stand">{b.s}</p> : <p>{b.s}</p>)}
  </div></section>
</Base>
