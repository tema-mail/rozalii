{
 "237995809/3807483501": "<!-- HOLIFLORI / TILDA VIBE BLOCK / PRODUCTS INTRO -->\n<section id=\"hf-products-intro\" style=\"padding-top: 75px;\">\n  <style>\n    #hf-products-intro{\n      width:100%;\n      background:#ffffff;\n      font-family:'Montserrat',Arial,sans-serif;\n      color:#1f1f1f;\n      box-sizing:border-box;\n    }\n\n    #hf-products-intro,\n    #hf-products-intro *{\n      box-sizing:border-box;\n    }\n\n    #hf-products-intro .hf-products-intro__inner{\n      width:100%;\n      max-width:1920px;\n      margin:0 auto;\n      padding:92px 42px 26px;\n    }\n\n    #hf-products-intro .hf-products-intro__title{\n      margin:0;\n      font-family:'Raleway',Arial,sans-serif;\n      font-size:34px;\n      line-height:1.03;\n      font-weight:700;\n      letter-spacing:-1px;\n      color:#003D20;\n    }\n\n    @media (max-width:1199px){\n      #hf-products-intro .hf-products-intro__inner{\n        padding:72px 28px 28px;\n      }\n\n      #hf-products-intro .hf-products-intro__title{\n        font-size:32px;\n      }\n    }\n\n    @media (max-width:767px){\n      #hf-products-intro .hf-products-intro__inner{\n        padding:54px 20px 28px;\n      }\n\n      #hf-products-intro .hf-products-intro__title{\n        font-size:32px;\n        line-height:1.05;\n        letter-spacing:-.8px;\n      }\n    }\n\n    @media (max-width:479px){\n      #hf-products-intro .hf-products-intro__inner{\n        padding:46px 18px 24px;\n      }\n\n      #hf-products-intro .hf-products-intro__title{\n        font-size:29px;\n      }\n    }\n  </style>\n\n  <div class=\"hf-products-intro__inner\">\n    <h2 class=\"hf-products-intro__title\">\n      Ритуальные венки\n    </h2>\n  </div>\n</section>",
